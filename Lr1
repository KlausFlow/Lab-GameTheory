import numpy as np
 
# Вариант 3
c = np.array([4.0, 10.0])
A = np.array([[7.0, 1.0],
              [1.0, 3.0]])
b = np.array([10.0, 15.0])
 
# Часть 1. Перебор вершин
def vertex_enumeration(A, b, c):
    # Границы ограничений + координатные оси
    boundaries_A = [A[0], A[1],
                    np.array([1.0, 0.0]),
                    np.array([0.0, 1.0])]
    boundaries_b = [b[0], b[1], 0.0, 0.0]
    vertices = []
 
    for i in range(len(boundaries_A)):
        for j in range(i + 1, len(boundaries_A)):
            M = np.vstack([boundaries_A[i], boundaries_A[j]])
            rhs = np.array([boundaries_b[i], boundaries_b[j]])
            if abs(np.linalg.det(M)) < 1e-12:
                continue
            x = np.linalg.solve(M, rhs)
            if np.all(x >= -1e-10) and np.all(A @ x <= b + 1e-10):
                if not any(np.allclose(x, v) for v in vertices):
                    vertices.append(x)
 
    values = [c @ x for x in vertices]
    k = int(np.argmax(values))
    return vertices, vertices[k], values[k]
 
# Часть 2. Пересчитываемый симплекс-метод
def revised_simplex(A, b, c):
    m, n = A.shape
    A_full = np.hstack([A, np.eye(m)])
    c_full = np.concatenate([c, np.zeros(m)])
 
    # Начальный базис – добавочные переменные
    basis = list(range(n, n + m))
    iteration = 0
 
    while True:
        iteration += 1
        B = A_full[:, basis]
        B_inv = np.linalg.inv(B)
        x_B = B_inv @ b
        c_B = c_full[basis]
 
        nonbasis = [j for j in range(n + m) if j not in basis]
        delta = {}
        for j in nonbasis:
            delta[j] = c_full[j] - c_B @ B_inv @ A_full[:, j]
 
        print(f"Итерация {iteration}: базис = {[i + 1 for i in basis]}")
        print("x_B =", x_B)
        print("Оценки =", {j + 1: delta[j] for j in nonbasis})
 
        # Для max оптимум достигнут, если все оценки <= 0
        if max(delta.values()) <= 1e-10:
            x = np.zeros(n + m)
            x[basis] = x_B
            return x[:n], c @ x[:n]
 
        # Входящая переменная – максимальная положительная оценка
        entering = max(nonbasis, key=lambda j: delta[j])
        d = B_inv @ A_full[:, entering]
 
        if np.all(d <= 1e-10):
            raise ValueError("Целевая функция не ограничена сверху")
 
        ratios = np.array([
            x_B[i] / d[i] if d[i] > 1e-10 else np.inf
            for i in range(m)
        ])
        leaving_row = int(np.argmin(ratios))
        basis[leaving_row] = entering
 
vertices, x_v, z_v = vertex_enumeration(A, b, c)
x_s, z_s = revised_simplex(A, b, c)
 
print("\nПеребор вершин:")
for x in vertices:
    print(x, "z =", c @ x)
print("Оптимум:", x_v, "z =", z_v)
 
print("\nСимплекс-метод:")
print("Оптимум:", x_s, "z =", z_s)
